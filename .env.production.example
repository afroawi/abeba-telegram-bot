# Copy to .env and fill in the two credentials before starting.
TELEGRAM_BOT_TOKEN=
# Must match ABEBA_TELEGRAM_SERVICE_TOKEN in the existing Django backend.
ABEBA_TELEGRAM_SERVICE_TOKEN=
ABEBA_API_BASE_URL=https://dashboard.abebachat.com/api/v1/
ABEBA_MINI_APP_URL=https://web.abebachat.com/telegram/chat
# Public status: https://bot.abebachat.com/healthz
# The production Compose file fixes the listener to 127.0.0.1:18151.

# Character art is packaged in the image. Set false for a text-only experience.
ABEBA_BOT_IMAGES_ENABLED=true
# Listen button and /listen; requires the updated backend and configured TTS.
ABEBA_BOT_AUDIO_ENABLED=true
