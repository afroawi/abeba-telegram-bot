TELEGRAM_BOT_TOKEN=
ABEBA_API_BASE_URL=http://127.0.0.1:8000/api/v1/
# Must match ABEBA_TELEGRAM_SERVICE_TOKEN on Django; generate a random secret.
ABEBA_TELEGRAM_SERVICE_TOKEN=
# A publicly accessible HTTPS frontend URL, ending in /telegram/chat.
ABEBA_MINI_APP_URL=https://your-web-domain.example/telegram/chat

# Standalone Compose host port; the health server listens on container port 8081.
BOT_BIND=127.0.0.1
BOT_PORT=18151
# For local Python runs; Compose sets the host to 0.0.0.0 inside Docker.
ABEBA_BOT_HEALTH_HOST=127.0.0.1
ABEBA_BOT_HEALTH_PORT=8081

# Character art is packaged in the image. Set false for a text-only experience.
ABEBA_BOT_IMAGES_ENABLED=true
# Listen button and /listen; requires the updated backend and configured TTS.
ABEBA_BOT_AUDIO_ENABLED=true
